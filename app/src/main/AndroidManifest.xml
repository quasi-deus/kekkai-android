<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Kekkai">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kekkai">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launched via the authentication IntentSender on the Autofill dataset;
             never started directly by another app. -->
        <activity
            android:name=".connector.autofill.AutofillPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Kekkai" />

        <service
            android:name=".connector.autofill.AutofillKekkaiService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

    </application>

</manifest>
